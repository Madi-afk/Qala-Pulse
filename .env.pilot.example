# Copy to .env.pilot; fill on the server. Never commit .env.pilot.
ENVIRONMENT=production
PILOT_DOMAIN=
ACME_EMAIL=
PUBLIC_API_URL=
CORS_ORIGINS=[]
POSTGRES_USER=qalapulse
POSTGRES_DB=qalapulse
POSTGRES_PASSWORD=
JWT_SECRET=
MINIO_ROOT_USER=qalapulse-pilot
MINIO_ROOT_PASSWORD=
MINIO_SECRET_KEY=
STORAGE_MODE=minio
RATE_LIMIT_ENABLED=true
AI_MODE=mock
PRIVACY_MODE=local
PILOT_REGISTRATION_CLOSED=true
PILOT_REGISTRATION_EMAILS=[]
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
METRICS_TOKEN=
PASSWORD_RESET_MINUTES=20
ORIGINAL_RETENTION_DAYS=7
AUDIO_RETENTION_DAYS=2
UNATTACHED_RETENTION_DAYS=7
PUBLIC_PHOTO_RETENTION_DAYS=90
# Separate off-host encrypted backup repository; supply auth using protected host files.
# Example: sftp:backup-user@backup-host:/srv/qalapulse-backup
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
